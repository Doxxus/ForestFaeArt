# The API this site talks to (staging until the production cut-over).
VITE_API_URL=https://ffa-api-staging.forestfaefolk.workers.dev
# The address people use for this site. It builds canonical links and the sitemap.
VITE_SITE_URL=https://ffa-web-staging.forestfaefolk.workers.dev
# Search engines are allowed in only when this is "true" AND the owner has published (ADR 011).
# Staging leaves it unset. The production environment sets it at cut-over.
# VITE_INDEXABLE=true
# Optional. See docs/staging.md for how to switch these on:
# VITE_TURNSTILE_SITE_KEY=
# VITE_ANALYTICS_TOKEN=
