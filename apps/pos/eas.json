{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ffa-api-staging.forestfaefolk.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://ffa-web-staging.forestfaefolk.workers.dev"
      }
    },
    "production": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.forestfae.ca",
        "EXPO_PUBLIC_WEB_URL": "https://forestfae.ca"
      }
    }
  }
}
