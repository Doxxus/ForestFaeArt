{
  "name": "@ffa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/router.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "create-user": "tsx scripts/create-user.ts",
    "restore-backup": "tsx scripts/restore-backup.ts"
  },
  "dependencies": {
    "@ffa/auth": "workspace:*",
    "@ffa/db": "workspace:*",
    "@ffa/validators": "workspace:*",
    "@trpc/server": "^11.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "wrangler": "^4.159.0"
  }
}
